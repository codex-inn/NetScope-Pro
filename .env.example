APP_NAME=NetScope Pro
APP_SECRET_KEY=replace-with-a-long-random-secret-before-running
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeThis-Immediately-Use-A-Long-Random-Password
# Empty means scanning is disabled. Add only CIDRs covered by written authorization.
# Example syntax: APPROVED_CIDRS=192.0.2.0/24
APPROVED_CIDRS=
MAX_TARGET_HOSTS=256
MAX_PORTS_PER_SCAN=25
SCAN_TIMEOUT_SECONDS=120
MAX_CONCURRENT_SCANS=1
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
SCHEDULER_ENABLED=false
HOST=127.0.0.1
PORT=8765
DATABASE_PATH=data/netscope.db
